# ==========================================
# DAYAVI (დაყავი) - ENVIRONMENT CONFIGURATION
# ==========================================

# 1. DATABASE (PostgreSQL / Neon)
# DATABASE_URL: Pooled connection string (used in production serverless runtime)
DATABASE_URL="postgresql://user:password@ep-sample-pooler.us-east-2.aws.neon.tech/dayavi?sslmode=require&pgbouncer=true"
# DIRECT_URL: Direct connection string (used by Prisma CLI for migrations)
DIRECT_URL="postgresql://user:password@ep-sample.us-east-2.aws.neon.tech/dayavi?sslmode=require"

# 2. AUTHENTICATION (Auth.js v5 / NextAuth)
# Generate with: openssl rand -base64 32
AUTH_SECRET="your-super-secret-auth-secret-32-chars-min"
NEXTAUTH_URL="http://localhost:3000"

# 3. OAUTH PROVIDERS (Optional)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""

# 4. EMAIL SERVICE (Optional; defaults to console in Dev)
RESEND_API_KEY=""
EMAIL_FROM="Dayavi <notifications@dayavi.app>"

# 5. ENVIRONMENT MODE
NODE_ENV="development"
